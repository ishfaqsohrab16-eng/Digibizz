FROM ghcr.io/railwayapp/nixpacks:ubuntu-1745885067

ENTRYPOINT ["/bin/bash", "-l", "-c"]
WORKDIR /app/


COPY .nixpacks/nixpkgs-ffeebf0acf3ae8b29f8c7049cd911b9636efd7e7.nix .nixpacks/nixpkgs-ffeebf0acf3ae8b29f8c7049cd911b9636efd7e7.nix
RUN nix-env -if .nixpacks/nixpkgs-ffeebf0acf3ae8b29f8c7049cd911b9636efd7e7.nix && nix-collect-garbage -d


ARG ALLOWED_ORIGINS CI DB_HOST DB_NAME DB_PASSWORD DB_PORT DB_USER GIT_SHA JWT_SECRET NIXPACKS_METADATA NODE_ENV NODE_TLS_REJECT_UNAUTHORIZED NPM_CONFIG_PRODUCTION SESSION_SECRET SMTP_FROM SMTP_HOST SMTP_PASS SMTP_PORT SMTP_SECURE SMTP_USER
ENV ALLOWED_ORIGINS=$ALLOWED_ORIGINS CI=$CI DB_HOST=$DB_HOST DB_NAME=$DB_NAME DB_PASSWORD=$DB_PASSWORD DB_PORT=$DB_PORT DB_USER=$DB_USER GIT_SHA=$GIT_SHA JWT_SECRET=$JWT_SECRET NIXPACKS_METADATA=$NIXPACKS_METADATA NODE_ENV=$NODE_ENV NODE_TLS_REJECT_UNAUTHORIZED=$NODE_TLS_REJECT_UNAUTHORIZED NPM_CONFIG_PRODUCTION=$NPM_CONFIG_PRODUCTION SESSION_SECRET=$SESSION_SECRET SMTP_FROM=$SMTP_FROM SMTP_HOST=$SMTP_HOST SMTP_PASS=$SMTP_PASS SMTP_PORT=$SMTP_PORT SMTP_SECURE=$SMTP_SECURE SMTP_USER=$SMTP_USER

# setup phase
# noop

# install phase
ENV NIXPACKS_PATH=/app/node_modules/.bin:$NIXPACKS_PATH
COPY . /app/.
RUN --mount=type=cache,id=6AeeHbq7LM-/root/npm,target=/root/.npm npm install

# build phase
# noop


RUN printf '\nPATH=/app/node_modules/.bin:$PATH' >> /root/.profile


# start
COPY . /app

CMD ["npm start"]

