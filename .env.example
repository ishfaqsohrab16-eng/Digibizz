# Environment Configuration Template
# Copy this file to .env and update values for your local setup
# DO NOT commit .env file to version control

# CORS - Allowed origins for API requests
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database Configuration
# For local development with XAMPP:
#   - DB_HOST: localhost
#   - DB_PORT: 3306 (default MySQL port)
#   - DB_USER: root (default XAMPP user)
#   - DB_PASSWORD: leave empty (default XAMPP password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lms_lmsdb

# JWT Secret - Generate a strong random string
# Example: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Session Secret - Generate a strong random string
SESSION_SECRET=your_session_secret_key_here_change_in_production

# Email Configuration (Optional)
# For Gmail: Use an App-specific password (not your actual password)
# Enable 2FA on Gmail and generate an app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_SECURE=true

# Server Port
PORT=3000
