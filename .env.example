# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_lmsdb
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Email provider
# ---------------------------------------------------------------------------
#
# Which service carries the mail. "auto" (the default) uses Brevo when
# BREVO_API_KEY is set and falls back to the SMTP settings below otherwise, so
# adding the key is the whole of the switchover and removing it is the whole
# of the rollback. Force one with EMAIL_PROVIDER=brevo or =smtp.
#
# Brevo is an HTTPS request to a public host, which an application container
# can always make - unlike SMTP to a mail server behind the same NAT, which is
# where this deployment's undelivered registration codes came from.
# EMAIL_PROVIDER=auto

# From https://app.brevo.com -> SMTP & API -> API Keys.
# BREVO_API_KEY=

# Brevo refuses to send from an address it has not verified, so this must be
# one you have confirmed under Senders, Domains & Dedicated IPs. Defaults to
# SMTP_FROM when unset.
# BREVO_SENDER_EMAIL=noreply@digibizz.gob.pk
# BREVO_SENDER_NAME=Digibizz Program

# The free plan is 300 emails a day, shared between campaigns and
# registration codes. The reserve is held back for codes, so a campaign can
# never leave applicants unable to confirm their address; a campaign larger
# than what is left simply continues the next day. Raise the limit here after
# upgrading the Brevo plan.
# BREVO_DAILY_LIMIT=300
# BREVO_TRANSACTIONAL_RESERVE=50
# EMAIL_QUOTA_TIMEZONE=Asia/Karachi

# Brevo contacts for addresses this app mailed are deleted this many hours
# after the last message to them, so the provider account does not accumulate
# a copy of everyone who ever applied. Set BREVO_DELETE_CONTACTS=false to stop
# deleting them.
# BREVO_CONTACT_TTL_HOURS=24
# BREVO_CONTACT_SWEEP_MINUTES=30
# BREVO_DELETE_CONTACTS=true

# When Brevo fails on mail somebody is waiting for - most usefully when the
# day's allowance is spent - fall back to the SMTP server below rather than
# leaving applicants unable to register until midnight. Transactional mail
# only: a fallback on campaign mail could mail a real applicant twice.
# EMAIL_FALLBACK_TO_SMTP=true

# Undeliverable mail is written to the email_outbox table and retried until
# it goes out or is abandoned, so a spent allowance or a mail server reboot
# is a delay rather than a message nobody receives. A message abandoned after
# MAX_ATTEMPTS raises an alert to EMAIL_ALERT_TO (default: SMTP_FROM).
# EMAIL_OUTBOX_DRAIN_SECONDS=60
# EMAIL_OUTBOX_MAX_ATTEMPTS=8
# EMAIL_OUTBOX_BATCH=25
# EMAIL_ALERT_TO=info@digibizz.gob.pk

# ---------------------------------------------------------------------------
# Email / SMTP
# ---------------------------------------------------------------------------
# In Docker, prefer the mail container's name on the shared network over the
# public hostname. Resolving mail.digibizz.gob.pk from a container on the
# same host sends the connection out to the public IP and back in (hairpin
# NAT), which many hosts route slowly or not at all - the usual cause of
# registration codes that arrive minutes late or never. An internal name
# connects in milliseconds. Confirm with:  node servec/diagnoseEmail.js
SMTP_HOST=mail.digibizz.gob.pk
SMTP_PORT=465
SMTP_USER=noreply@digibizz.gob.pk
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM=noreply@digibizz.gob.pk
SMTP_FROM_NAME=Digibizz Program

# The mail server currently uses a SELF-SIGNED certificate, so certificate
# verification must stay off or every send fails with
# "ESOCKET: self-signed certificate". This is scoped to SMTP only.
# Set it to true once a valid (e.g. Let's Encrypt) certificate is installed.
SMTP_TLS_REJECT_UNAUTHORIZED=false

# Optional
# SMTP_REPLY_TO=info@digibizz.gob.pk
# SMTP_DEBUG=true            # log the full SMTP conversation
# SUPPORT_EMAIL=info@digibizz.gob.pk
# LMS_PORTAL_URL=https://lms.digibizz.gob.pk

# How long a registration request waits for the mail server before it
# answers the applicant. Past this the send finishes in the background and
# the code still works when it lands - the applicant is simply not made to
# watch a spinner. Default 8000.
# VERIFY_SEND_WAIT_MS=8000

# ---------------------------------------------------------------------------
# Feature switches (config/features.js)
# ---------------------------------------------------------------------------

# The bulk email campaign module. OFF by default: the sidebar entry is
# hidden, every /api/email-campaigns endpoint answers 503, and the dispatcher
# does not start, so nothing queued goes out. Existing campaigns and their
# history are kept and resume where they stopped when it is switched back on.
# The UI half of this switch lives in Frontend/src/utils/features.ts and has
# to be flipped with it, then rebuilt.
# Transactional mail - registration codes, password resets, notifications -
# is not affected by this and keeps working either way.
# EMAIL_CAMPAIGNS_ENABLED=false

# ---------------------------------------------------------------------------
# Data assistant (Super Admin only)
# ---------------------------------------------------------------------------
#
# Ask questions about the programme's data in English. The model writes SQL,
# utils/sqlGuard.js decides whether it may run, and the rows come back for it
# to explain. It can only ever read.
#
# The thinking is done by a FreeLLMAPI router - a self-hosted proxy that holds
# API keys for dozens of providers' free tiers and puts one OpenAI-compatible
# endpoint in front of them. It knows what every key has left and picks a model
# that is free right now AND able to call tools.
#
# Talking to one provider directly does not work for this. A free Groq key
# allows 8,000 tokens a minute per model, and a question costs several thousand
# across its rounds - so the second question of a session was rate limited.
#
# THE ONLY REQUIRED SETTING. From the router's dashboard, Keys page, "Your
# unified API key". Never commit it.
# FREELLM_API_KEY=freellmapi-...
#
# Where the router is. Include its /v1 prefix. The default points at the
# instance already deployed alongside this app.
# FREELLM_API_BASE_URL=https://digibizz-program-freellmapi.aeju8m.easypanel.host/v1
#
# LEAVE THIS UNSET. It defaults to "auto", which is the whole point: "auto"
# lets the router choose from its entire catalogue, while naming a model pins
# it to the single route that serves that model. Measured against the live
# router - a named model answered 429 "All models exhausted: 1 route checked",
# where "auto" answered normally. Setting it can only make things worse.
# FREELLM_MODEL=auto
#
# Longer than a direct provider call would need, because one request here may
# be several attempts on the router's side as it moves past busy providers.
# FREELLM_TIMEOUT_MS=90000
#
# Every question is screened for prompt injection before the analyst sees it.
# This runs on "auto" as well: the purpose-built classifiers
# (llama-prompt-guard) have a 512-token context, which is below what the
# router will route to, so every request to one came back 413 - screening
# silently stopped happening. An ordinary model asked for a one-word verdict
# was right on all eleven test cases, in about 0.9s each. It is a second line -
# utils/sqlGuard.js still decides what runs - and it fails open, so a screening
# outage cannot block real work.
# FREELLM_SCREEN_MODEL=auto

# How many times the assistant may query before it has to answer. It spends
# one round reading the columns of the tables it needs, one or two checking
# what is actually in them, one on the query that answers the question, and
# one presenting. Below about six it starts having to guess.
# AI_MAX_ROUNDS=8
# AI_SCHEMA_CACHE_MS=600000

# What a question fetches stays available to the rest of that conversation,
# so a follow-up like "show that as a table" is answered from data already
# in hand instead of costing another minute of inference. Held in memory,
# per conversation, dropped when it expires.
# AI_CONVERSATION_TTL_MS=3600000
# AI_MAX_DATASETS=8

# THE CONTROL THAT ACTUALLY MATTERS.
#
# utils/sqlGuard.js filters the SQL, and a filter on text can be wrong. A
# database account holding nothing but SELECT cannot be:
#
#   CREATE USER 'lms_readonly'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON lms_lmsdb.* TO 'lms_readonly'@'%';
#   FLUSH PRIVILEGES;
#
# Without these the assistant runs on the application's own connection and
# says so at boot, and on the screen. That is a weaker deployment.
# AI_DB_USER=lms_readonly
# AI_DB_PASSWORD=

# NOTE: NODE_TLS_REJECT_UNAUTHORIZED=0 is no longer required and should be
# removed from the deployment - it disabled TLS verification process-wide
# (database, outbound APIs), not just for email.
